{
  "entities": {
    "TranscriptNote": {
      "title": "TranscriptNote",
      "description": "An Arabic or multilingual audio transcription note saved by the user, with optional AI-organized text for export.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "rawText": { "type": "string" },
        "organizedText": { "type": "string" },
        "language": { "type": "string" },
        "formatStyle": {
          "type": "string",
          "enum": ["RAW", "CLEAN_PARAGRAPHS", "MEETING_NOTES", "BULLET_SUMMARY"]
        },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "rawText", "language", "formatStyle", "durationSeconds", "createdAt", "updatedAt"]
    },
    "VoiceProfile": {
      "title": "VoiceProfile",
      "description": "User vocal signature & cloned voice profile derived from a recorded or uploaded audio sample.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "baseVoiceName": { "type": "string" },
        "toneDescription": { "type": "string" },
        "dialectNotes": { "type": "string" },
        "deliveryStyle": { "type": "string" },
        "clonedVoiceId": { "type": "string" },
        "pitchShift": { "type": "number" },
        "speechRate": { "type": "number" },
        "voiceDepth": { "type": "number" },
        "sampleDurationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "baseVoiceName", "toneDescription", "dialectNotes", "deliveryStyle", "pitchShift", "speechRate", "voiceDepth", "sampleDurationSeconds", "createdAt", "updatedAt"]
    },
    "GeneratedSpeech": {
      "title": "GeneratedSpeech",
      "description": "History entry for emotion-aware text-to-speech synthesis.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "voiceProfileName": { "type": "string" },
        "baseVoiceName": { "type": "string" },
        "detectedEmotion": { "type": "string" },
        "pitchShift": { "type": "number" },
        "speechRate": { "type": "number" },
        "voiceDepth": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "voiceProfileName", "baseVoiceName", "detectedEmotion", "pitchShift", "speechRate", "voiceDepth", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/transcripts/{transcriptId}": {
      "schema": { "$ref": "#/entities/TranscriptNote" },
      "description": "Saved audio transcription notes belonging to the authenticated user."
    },
    "/users/{userId}/voiceProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/VoiceProfile" },
      "description": "Saved personal & cloned voice profiles."
    },
    "/users/{userId}/generatedSpeeches/{speechId}": {
      "schema": { "$ref": "#/entities/GeneratedSpeech" },
      "description": "Saved history of emotion-aware text-to-speech generations."
    }
  }
}
